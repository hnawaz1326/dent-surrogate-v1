    "# Step 2 - DATA CLEANING (inject a few real-world messes, then fix them)\n",
    "# Simulate two classic problems: unit slips (microns typed as mm) and missing values\n",
    "\n",
    "dirty = df.copy()\n",
    "dirty.loc[dirty.sample(10, random_state=1).index, \"thickness_mm\"] *= 100   # unit slip (mm -> microns)\n",
    "dirty.loc[dirty.sample(8, random_state=2).index, \"panel_span_mm\"] = np.nan  # missing values\n",
    "\n",
    "before = len(dirty)\n",
    "dirty = dirty[(dirty[\"thickness_mm\"] > 0.3) & (dirty[\"thickness_mm\"] < 3.0)]  # kill unit slips\n",
    "dirty = dirty.dropna()                                                        # kill missing rows\n",
    "df = dirty.reset_index(drop=True)\n",
    "print(f\"[CLEAN] removed {before - len(df)} bad rows (unit slips + missing); {len(df)} rows remain\")\n",
    "\n",
    "FEATURES = [\"thickness_mm\", \"panel_span_mm\", \"curvature_1_per_m\",\n",
    "            \"yield_strength_mpa\", \"youngs_modulus_gpa\"]\n",
    "X = df[FEATURES]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "8769bf39-913b-4182-bc34-6085ca085dbf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DENT RESISTANCE (regression)\n",
      "  MAE  =   23.9 N       (baseline 'guess average' MAE =  125.8 N)\n",
      "  RMSE =   34.6 N\n",
      "  R2   =  0.954          (1.0 = perfect, 0 = no better than the average)\n",
      "\n",
      "OIL-CANNING (classification: 1 = oil-cans)\n",
      "  Accuracy  = 0.916  (baseline 'always guess majority' = 0.540)\n",
      "  Precision = 0.929  Recall = 0.914  ROC-AUC = 0.979\n",
      "  Confusion matrix [rows=true, cols=pred]:\n",
      "  [[100, 9], [11, 117]]\n",
      "\n"
     ]
    }
   ],
   "source": [
    "# STEP 3 - Split into TRAIN/TEST (test data the model NEVER sees while learning)\n",
    "# NOTE on LEAKAGE: here every row is an independent panel, so a random split is fine.\n",
    "# In a real program you would split by geometry FAMILY, so near-identical panels don't\n",
    "# end up in both train and test.\n",
    "Xtr, Xte, ytr_d, yte_d, ytr_o, yte_o = train_test_split(\n",
    "    X, df[\"dent_force_N\"], df[\"oilcans\"], test_size=0.20, random_state=42)\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# STEP 4 - TRAIN THE MODEL\n",
    "# ----------------------------------------------------------------------------------\n",
    "dent_model = HistGradientBoostingRegressor(random_state=42).fit(Xtr, ytr_d)\n",
    "oil_model  = HistGradientBoostingClassifier(random_state=42).fit(Xtr, ytr_o)\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# STEP 5 - VALIDATE (how good is it? and always compare to a dumb baseline)\n",
    "# ----------------------------------------------------------------------------------\n",
    "pred_d = dent_model.predict(Xte)\n",
    "mae    = mean_absolute_error(yte_d, pred_d)\n",
    "rmse   = mean_squared_error(yte_d, pred_d) ** 0.5\n",
    "r2     = r2_score(yte_d, pred_d)\n",
    "baseline_mae = mean_absolute_error(yte_d, np.full_like(yte_d, ytr_d.mean()))\n",
    "\n",
    "print(\"DENT RESISTANCE (regression)\")\n",
    "print(f\"  MAE  = {mae:6.1f} N       (baseline 'guess average' MAE = {baseline_mae:6.1f} N)\")\n",
    "print(f\"  RMSE = {rmse:6.1f} N\")\n",
    "print(f\"  R2   = {r2:6.3f}          (1.0 = perfect, 0 = no better than the average)\\n\")\n",
    "\n",
    "pred_o  = oil_model.predict(Xte)\n",
    "proba_o = oil_model.predict_proba(Xte)[:, 1]\n",
    "acc     = accuracy_score(yte_o, pred_o)\n",
    "prec    = precision_score(yte_o, pred_o)\n",
    "rec     = recall_score(yte_o, pred_o)\n",
    "auc     = roc_auc_score(yte_o, proba_o)\n",
    "base_acc = max(yte_o.mean(), 1 - yte_o.mean())\n",
    "cm = confusion_matrix(yte_o, pred_o)\n",
    "\n",
    "print(\"OIL-CANNING (classification: 1 = oil-cans)\")\n",
    "print(f\"  Accuracy  = {acc:5.3f}  (baseline 'always guess majority' = {base_acc:5.3f})\")\n",
    "print(f\"  Precision = {prec:5.3f}  Recall = {rec:5.3f}  ROC-AUC = {auc:5.3f}\")\n",
    "print(f\"  Confusion matrix [rows=true, cols=pred]:\\n  {cm.tolist()}\\n\")\n",
    "\n",
    "                                                                      \n",
    "\n"
   ]
  },
