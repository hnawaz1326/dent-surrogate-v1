    "\"\"\"\n",
    "DENT / OIL-CANNIONG SURROGATE - V1 PROOF-OUT\n",
    "--------------------------------------------\n",
    "--------------------------------------------\n",
    "GOAL: predict, from ROUGH EARLy geometry, whether hood panel will\n",
    "    (a) DENT -> how much force it takes to leave a permanent mark (a number\n",
    "    (b) OIL-CAN -> does it pop in/out under load, yes/no          (b label\n",
    "\n",
    "    so the designer gets the answer at thier desk, instead of waiting weeks for the final class A-surface + full FEA solve\n",
    "    Important - WHAT THIS DATA is: A  surrogate is always trained on simulation output. I dont have FORD's sim courpus yet, so we GENERATE\n",
    "    a physically-plausible dataset from known panel-mechanics relatioships + realistic noise. This proves the technique.\n",
    "    These numbers are NOT real Ford results. Proof-out proves the method; Ford deployment is gates on the real sim data.\n",
    " \"\"\"   \n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib\n",
    "matplotlib.use(\"Agg\")       # save plots to file, no display needed\n",
    "import matplotlib\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt   \n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import HistGradientBoostingRegressor, HistGradientBoostingClassifier\n",
    "from sklearn.metrics import (mean_absolute_error, mean_squared_error, r2_score,\n",
    "                             accuracy_score, precision_score, recall_score,\n",
    "                             roc_auc_score, confusion_matrix)\n",
    "from sklearn.inspection import permutation_importance\n",
    "\n",
    "np.random.seed(42)     # reproducible: re-run -> same numbers\n",
    "\n",
    "OUT = \"C:/Users/HNAWAZ1/Documents/outputs\"\n",
    "os.makedirs(OUT, exist_ok=True)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "03e98c7b-1545-4cfd-9e2a-e826d082658b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 1 - MAKE THE DATASET (each panel = few numbers a designer knows early)\n",
    "N = 1200\n",
    "thickness_mm      = np.random.uniform(0.65, 1.15, N)      # sheet thickness\n",
    "panel_span_mm     = np.random.uniform(350, 850, N)        # largest UNSUPPORTED distance\n",
    "curvature_1_per_m = np.random.uniform(0.10, 1.40, N)      # how curved (flat=low, dome=high)\n",
    "yield_strength    = np.random.choice([180, 210, 240, 280, 340], N) + np.random.uniform(-10, 10, N)\n",
    "youngs_modulus    = np.random.uniform(196, 206, N)        # steel stiffness (varies slightly)\n",
    "\n",
    "# ---- physics we are baking in (directions are real engineering, magnitudes are illustrative) ----\n",
    "# DENT force: up with thickness^2 and yield and curvature, down with span\n",
    "dent_force_N = (1.0 * yield_strength * thickness_mm**2\n",
    "                * (1 + 0.8 * curvature_1_per_m)\n",
    "                * (youngs_modulus / 200.0)**0.3\n",
    "                / (panel_span_mm / 500.0)**1.2)\n",
    "dent_force_N *= np.random.normal(1.0, 0.08, N)            # +-8% \"sim scatter\" noise\n",
    "\n",
    "# Oil-can margin: high = safe. Flat + thin + large => oil-cans. Curvature matters.\n",
    "oilcan_margin = (0.2 * youngs_modulus * thickness_mm**2\n",
    "                 * (1 + 3.0 * curvature_1_per_m)\n",
    "                 / (panel_span_mm / 500.0)**2)\n",
    "oilcan_margin_noisy = oilcan_margin + np.random.normal(0, 0.15 * oilcan_margin.std(), N)\n",
    "oilcan = (oilcan_margin_noisy < np.median(oilcan_margin)).astype(int)   # 1 = it oil-cans\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"thickness_mm\": thickness_mm,\n",
    "    \"panel_span_mm\": panel_span_mm,\n",
    "    \"curvature_1_per_m\": curvature_1_per_m,\n",
    "    \"yield_strength_mpa\": yield_strength,\n",
    "    \"youngs_modulus_gpa\": youngs_modulus,\n",
    "    \"dent_force_N\": dent_force_N,\n",
    "    \"oilcans\": oilcan,\n",
    "})\n"
   ]
  },
