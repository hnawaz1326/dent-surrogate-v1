    "# ----------------------------------------------------------------------------------\n",
    "# STEP 6 - WHERE DOES IT BREAK? (THE SURROGATE'S HONEST LIMIT, MADE VISIBLE)\n",
    "# ----------------------------------------------------------------------------------\n",
    "# Retrain dent model on a NARROW thickness band, then test INSIDE vs OUTSIDE that band.\n",
    "band = (Xtr[\"thickness_mm\"] >= 0.75) & (Xtr[\"thickness_mm\"] <= 1.00)\n",
    "m_band = HistGradientBoostingRegressor(random_state=42).fit(Xtr[band], ytr_d[band])\n",
    "\n",
    "in_mask  = (Xte[\"thickness_mm\"] >= 0.75) & (Xte[\"thickness_mm\"] <= 1.00)\n",
    "out_mask = ~in_mask\n",
    "\n",
    "mae_in  = mean_absolute_error(yte_d[in_mask],  m_band.predict(Xte[in_mask]))\n",
    "mae_out = mean_absolute_error(yte_d[out_mask], m_band.predict(Xte[out_mask]))\n",
    "\n",
    "print(\"OUT-OF-DISTRIBUTION CHECK (dent model trained only on thickness 0.75-1.00 mm)\")\n",
    "print(f\"  error INSIDE training range  = {mae_in:6.1f} N\")\n",
    "print(f\"  error OUTSIDE training range = {mae_out:6.1f} N  <- trust collapses outside the training range\\n\")\n",
    "\n",
    "\n",
    "                 "
   ]
